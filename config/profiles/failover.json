{
  "backends": [{"priority": 0, "weight": 1}, {"priority": 1, "weight": 1}],
  "maxRetryAttempts": 1,
  "failures": [
    {
      "when": "@cel(response == null || response.status_code in [408, 429, 500, 502, 503, 504])",
      "retryAttempts": 0,
      "excludeFor": "PT30S"
    },
    {
      "when": "@cel(response != null && response.status_code == 404)",
      "retryAttempts": 0,
      "excludeFor": "PT30S"
    }
  ],
  "policies": []
}
